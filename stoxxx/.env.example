# Google AI Studio API Key (Obtén la tuya en https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Proveedor de TTS: 'edge' (por defecto, gratuito y sin claves) o 'google'
TTS_PROVIDER=edge

# Voces para el podcast dual (Edge-TTS)
TTS_VOICE_MALE=es-ES-AlvaroNeural
TTS_VOICE_FEMALE=es-ES-ElviraNeural

# Horizonte de búsqueda en días (por defecto: 14)
DAYS_HORIZON=14

# Si deseas publicar automáticamente a GitHub Pages en cada ejecución (True/False)
AUTO_GIT_PUSH=false
